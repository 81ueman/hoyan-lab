version = "hoyan/v1"

let devices = ["bj-edge1", "sh-edge1"]
let prefixes = ["10.4.0.0/16", "203.0.113.0/24"]

snapshot "current" {
  lab = "labs/base-wan"
}

scenario "normal" {
  snapshot = "current"
}

intent "cartesian-rib-check" {
  scenario = "normal"
  forall device in $devices, prefix in $prefixes {
    rib where device = $device, prefix = $prefix {
      count() >= 0
    }
  }
}
