version = "hoyan/v1"

snapshot "current" {
  lab = "labs/base-wan"
}

scenario "normal" {
  snapshot = "current"
}

intent "route-has-specific-community" {
  scenario = "normal"

  rib where communities contains "65000:100" {
    count() == [0]
  }
}

intent "aspath-matches-regex" {
  scenario = "normal"

  rib where as_path matches ".*99999.*" {
    count() == [0]
  }
}

intent "nexthop-filter-basic" {
  scenario = "normal"

  rib where nexthop = "10.255.1.1" {
    count() >= 0
  }
}

intent "nexthop-filter-contains" {
  scenario = "normal"

  rib where nexthop contains "10.255" {
    count() >= 0
  }
}

intent "if-device-is-edge-then-has-service-prefix" {
  scenario = "normal"

  rib where imply {
    device_in = ["bj-edge1", "sh-edge1", "gz-edge1"]
    then prefix = "10.4.0.0/16"
  } {
    count() >= 1
  }
}
