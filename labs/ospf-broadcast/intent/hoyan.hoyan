version = "hoyan/v1"

// Model limitation: the OSPF model does not expose DR/BDR election state.
// The spec suggested verifying DR existence ("DRが存在することの確認（モデルによる）"),
// but the RIB output contains no DR/BDR field. OSPF reachability across the
// broadcast segment is verified via broadcast-routers-see-each-other.

snapshot "current" {
  lab = "labs/ospf-broadcast"
}

scenario "normal" {
  snapshot = "current"
}

intent "all-ospf-routes-are-intra-area" {
  scenario = "normal"

  when where protocol = "ospf" {
    distVals(route_type) == ["intra_area"]
  }
}

intent "r1-loopback-reachable-from-other-routers" {
  scenario = "normal"

  rib where protocol = "ospf", prefix = "10.255.1.1/32" {
    count() >= 3
  }
}

intent "r4-loopback-reachable-from-all-routers" {
  scenario = "normal"

  rib where protocol = "ospf", prefix = "10.255.4.4/32" {
    count() >= 4
  }
}

intent "each-router-has-ospf-nexthops" {
  scenario = "normal"

  forall device in ["r1", "r2", "r3", "r4"] {
    rib where protocol = "ospf" {
      distCnt(nexthop) >= 1
    }
  }
}

intent "broadcast-routers-see-each-other" {
  scenario = "normal"

  forall device in ["r2", "r3"] {
    rib where protocol = "ospf", prefix = "198.51.100.0/29" {
      distCnt(nexthop) >= 1
    }
  }
}
