version = "hoyan/v1"

let service_ip = "10.4.1.10"
let service_prefix = "10.4.0.0/16"
let customers = ["cust-bj", "cust-sh", "cust-gz"]
let edges = ["bj-edge1", "sh-edge1", "gz-edge1"]

snapshot "current" {
  lab = "labs/acl-semantics"
}

scenario "normal" {
  snapshot = "current"
}

intent "service-prefix-visible-on-edges" {
  scenario = "normal"

  forall edge in $edges {
    rib where device = $edge, prefix = $service_prefix {
      count() >= 1
    }
  }
}

intent "customers-http-denied" {
  scenario = "normal"

  forall src in $customers {
    packet from $src to $service_ip tcp/80 expect false
  }
}

intent "customers-https-allowed" {
  scenario = "normal"

  forall src in $customers {
    packet from $src to $service_ip tcp/443 expect true
  }
}

intent "customers-see-service-prefix" {
  scenario = "normal"

  forall src in $customers {
    rib where device = $src, prefix = $service_prefix, protocol = "bgp" {
      count() >= 1
    }
  }
}

intent "bgp-routes-on-all-edges" {
  scenario = "normal"

  forall device in ["bj-edge1", "sh-edge1", "gz-edge1", "hz-edge1"] {
    rib where protocol = "bgp" {
      count() >= 1
    }
  }
}

intent "acl-default-action-permits-other-traffic" {
  scenario = "normal"

  forall src in $customers {
    packet from $src to $service_ip tcp/22 expect true
  }
}
