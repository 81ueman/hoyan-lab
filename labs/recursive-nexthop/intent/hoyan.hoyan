version = "hoyan/v1"

snapshot "current" {
  lab = "labs/recursive-nexthop"
}

scenario "normal" {
  snapshot = "current"
}

intent "bgp-routes-on-edge-routers" {
  scenario = "normal"

  forall device in ["bj-edge1", "sh-edge1", "gz-edge1", "hz-edge1"] {
    rib where protocol = "bgp" {
      count() >= 1
    }
  }
}

intent "bgp-routes-on-core-routers" {
  scenario = "normal"

  forall device in ["core-bj", "core-sh", "core-gz", "core-hz"] {
    rib where protocol = "bgp" {
      count() >= 1
    }
  }
}

intent "service-prefix-visible-via-bgp" {
  scenario = "normal"

  forall device in ["bj-edge1", "sh-edge1", "gz-edge1", "core-bj", "core-sh", "core-gz"] {
    rib where protocol = "bgp", prefix = "10.4.0.0/16" {
      count() >= 1
    }
  }
}

intent "bgp-routes-have-nexthops" {
  scenario = "normal"

  forall device in ["bj-edge1", "sh-edge1", "gz-edge1", "hz-edge1", "bj-edge2", "sh-edge2", "gz-edge2", "hz-edge2", "core-bj", "core-sh", "core-gz", "core-hz"] {
    when where protocol = "bgp" {
      distCnt(nexthop) >= 1
    }
  }
}

intent "bj-edge1-sees-sh-service-prefix" {
  scenario = "normal"

  rib where device = "bj-edge1", protocol = "bgp", prefix = "10.2.0.0/16" {
    count() >= 1
  }
}

intent "hz-edge1-sees-bj-service-prefix" {
  scenario = "normal"

  rib where device = "hz-edge1", protocol = "bgp", prefix = "10.1.0.0/16" {
    count() >= 1
  }
}
