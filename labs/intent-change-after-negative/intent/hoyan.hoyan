version = "hoyan/v1"

let changed_prefix = "10.4.0.0/16"

snapshot "pre" {
  lab = "labs/intent-change-before"
}

snapshot "post" {
  lab = "labs/intent-change-after-negative"
}

scenario "normal" {
  snapshot = "pre"
}

intent "unrelated-routes-changed" {
  diff "pre" "post" where not { prefix = $changed_prefix }
}
